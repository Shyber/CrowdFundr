# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- PostgreSQL (postgresql/app.py) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=crowdfundr
PGUSER=postgres
PGPASSWORD=your_postgres_password

# --- MongoDB (mongodb/app.py) ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=crowdfundr

# --- Admin menu of both console apps ---
# No default value: if this is not set, admin access is disabled.
CROWDFUNDR_ADMIN_PASSWORD=choose-a-password
